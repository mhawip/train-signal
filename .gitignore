# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js
.next/
out/
build/
dist/

# Secrets — never commit these
.env
.env.local
.env*.local

# Raw open data. Multi-gigabyte downloads.
# Only derived outputs in data/ are committed.
data/raw/
*.csv.gz
pipeline/tmp/

# Test output
coverage/
playwright-report/
test-results/
.lighthouseci/

# Agent loop logs — useful locally, noise in the repo
agent/logs/

# Pause sentinel. Local control only — and the loop's `git add -A` would
# otherwise commit it into whatever branch happens to be open.
agent/PAUSE

# Editors and OS
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
