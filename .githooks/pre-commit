#!/bin/sh
#
# Pre-commit hook: reject staged files larger than 10 MB.
# Prevents accidental commits of raw Ofcom data or other large files.

MAX_SIZE=10485760  # 10 MB in bytes
EXIT_CODE=0

# List staged files (added or modified), skip deleted files
for file in $(git diff --cached --name-only --diff-filter=d); do
    # Get the size of the staged version (not the working tree version)
    size=$(git cat-file -s ":${file}" 2>/dev/null || echo 0)
    if [ "$size" -gt "$MAX_SIZE" ]; then
        echo "BLOCKED: ${file} is $(( size / 1048576 )) MB (limit is 10 MB)"
        EXIT_CODE=1
    fi
done

if [ "$EXIT_CODE" -ne 0 ]; then
    echo ""
    echo "Large files must not be committed. Add them to .gitignore or use data/raw/."
    echo "If this is intentional, talk to devops."
fi

exit $EXIT_CODE
