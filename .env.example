# Copy this file to .env.local and fill in the real values.
#
#   .env.local is gitignored and must never be committed.
#   These are also set in the Vercel project's environment variables.
#
# None of these may be prefixed NEXT_PUBLIC_. That prefix ships the value
# to the browser, which for a credential is a security incident.

# --- Rail Data Marketplace: Darwin LDBWS -----------------------------------
# https://raildata.org.uk -> Data Product Catalogue -> search "LDBWS"
# -> subscribe to "Live Departure Board Web Service (LDBWS) - Public"
# The key appears on your RDM profile page.
DARWIN_API_KEY=

# --- Network Rail SCHEDULE feed --------------------------------------------
# https://datafeeds.networkrail.co.uk
# Basic auth, not an API key. Username is usually the email you registered with.
NR_FEEDS_USER=
NR_FEEDS_PASS=
